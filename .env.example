# Database (sync psycopg driver)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/userdata

# JWT — REQUIRED, no default. The app refuses to start without it (a fallback
# value would mean anyone could forge a token for any user). At least 32 chars.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440

# CORS: comma-separated origins. Production serves everything same-origin via
# nginx, so this only matters for direct access / local dev.
ALLOWED_ORIGINS=http://localhost:5173

# Ingestion: shared secret the screener (stock_market run_intraday) sends in the
# X-Ingest-Token header when POSTing daily screening snapshots. Empty = disabled.
INGEST_TOKEN=

# App
APP_PORT=8100

# ---------------------------------------------------------------------------
# Email (verification + password reset)
# ---------------------------------------------------------------------------

# Public URL of the FRONTEND. Links in emails are built as
#   {APP_BASE_URL}/?verify=<token>   and   {APP_BASE_URL}/?reset=<token>
# so this must be the address a user's browser can actually reach.
APP_BASE_URL=http://localhost:5173

# console = write the message (including the link) to the application log.
#           No SMTP account needed — the right default for development.
# smtp    = send for real using the SMTP_* settings below.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@localhost
EMAIL_FROM_NAME=Stock Quant

# Only needed when EMAIL_BACKEND=smtp.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, and use an
# App Password (https://myaccount.google.com/apppasswords) — not your login
# password, and not committed to git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# Token lifetimes (minutes)
EMAIL_VERIFY_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30

# Rate limiting on login / register / password-reset endpoints.
# In-process and per-worker: see app/ratelimit.py before scaling out.
RATE_LIMIT_ENABLED=true

# Postgres (used by docker-compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=userdata
